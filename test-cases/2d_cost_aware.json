{
  "name": "2D Cost-Aware Stock Selection",
  "description": "A larger sheet holding two parts is cheaper than two small sheets holding one part each",
  "input": {
    "dimension": "2D",
    "kerf": 0.0,
    "stocks": [
      { "id": "small-1000x1000", "width": 1000.0, "height": 1000.0, "quantity": 10, "cost": 100 },
      { "id": "large-2000x1000", "width": 2000.0, "height": 1000.0, "quantity": 10, "cost": 120 }
    ],
    "parts": [
      { "id": "panel", "name": "Panel", "width": 900.0, "height": 900.0, "quantity": 4 }
    ]
  },
  "expected": {
    "all_placed": true,
    "stock_ids": ["large-2000x1000", "large-2000x1000"],
    "total_cost": 240
  }
}
